{
  "manifest_version": 3,
  "name": "Domain Swapper",
  "version": "1.0",
  "description": "Automatically swap between predefined domains",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "domain-swapper@vicentedpsantos",
      "strict_min_version": "128.0"
    }
  }
}
